        "features": [
          {
            "name": "Archery",
            "desc": [
              "You gain a +2 bonus to attack rolls you make with Ranged weapons."
            ]
          },
          {
            "name": "Background: Acolyte",
            "desc": [
              "Tumbuh dalam komunitas keagamaan, mempelajari ritual dan pelayanan."
            ]
          },
          {
            "name": "Fighting Style",
            "desc": [
              "You have honed your martial prowess and gain a Fighting Style feat of your choice (see \"Feats\"). Defense is recommended.\n  Whenever you gain a Fighter level, you can replace the feat you chose with a different Fighting Style feat."
            ]
          },
          {
            "name": "Second Wind",
            "desc": [
              "You have a limited well of physical and mental stamina that you can draw on. As a Bonus Action, you can use it to regain Hit Points equal to 1d10 plus your Fighter level.\n  You can use this feature twice. You regain one expended use when you finish a Short Rest, and you regain all expended uses when you finish a Long Rest.\n  When you reach certain Fighter levels, you gain more uses of this feature, as shown in the Second Wind column of the Fighter Features table."
            ]
          },
          {
            "name": "Weapon Mastery",
            "desc": [
              "Your training with weapons allows you to use the mastery properties of three kinds of Simple or Martial weapons of your choice. Whenever you finish\na Long Rest, you can practice weapon drills and change one of those weapon choices.\n  When you reach certain Fighter levels, you gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Fighter Features table."
            ]
          },
          {
            "name": "Celestial Resistance",
            "desc": [
              "Resistansi necrotic dan radiant. Darkvision 60 ft. Senses, resistansi, dan efek transformasi dilacak manual."
            ]
          },
          {
            "name": "Healing Hands",
            "desc": [
              "Magic action: sentuh satu makhluk, pulihkan HP sebesar PB d4; 1/long rest, dilacak manual."
            ]
          },
          {
            "name": "Light Bearer",
            "desc": [
              "Light memakai CHA."
            ]
          },
          {
            "name": "Magic Initiate",
            "desc": [
              "Pilih INT, WIS, atau CHA untuk dua cantrip dan satu spell level 1 dari daftar terkait. Spell level 1 selalu prepared, dapat dipakai sekali tanpa slot per long rest dan dengan slot yang tersedia. Saat naik level, boleh mengganti satu spell dengan spell level sama dari daftar itu."
            ]
          }
